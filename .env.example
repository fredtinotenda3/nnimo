# ---------------------------------------------------------------------------
# Nnino Ceramics — environment
# Copy to `.env` for local development. Never commit `.env`.
#
# Most variables here are validated at boot by lib/env.ts. The exceptions are the
# three SEED_OWNER_* values, which are read directly by prisma/seed.ts and are
# never needed by the running application — corrected in Phase 8, where the old
# blanket claim ("every variable here is validated") was found to be untrue.
# ---------------------------------------------------------------------------

# Postgres. Local: docker compose up (see docs/architecture/local-development.md)
# Production: a managed instance (Neon / Supabase). Use the POOLED url for the app.
DATABASE_URL="postgresql://nnino:nnino@localhost:5432/nnino?schema=public"
# Direct (unpooled) connection, used by `prisma migrate`. Same value locally.
DIRECT_DATABASE_URL="postgresql://nnino:nnino@localhost:5432/nnino?schema=public"

# PHASE 8: maximum pg connections held per process. Left unset, node-postgres
# pools 10 PER INSTANCE, which on Vercel means 10 x every concurrently-warm
# serverless instance against a managed Postgres whose ceiling is a few hundred.
# The default of 5 leaves room for the 3-4 parallel queries the public pages
# issue while keeping 20 warm instances under 100 connections. Reasoned, not
# load-tested - see lib/db.ts.
# DATABASE_POOL_MAX="5"

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical origin. Required in production for correct cookie + callback handling.
AUTH_URL="http://localhost:3000"

# Public site origin, used for canonical URLs, sitemap, robots.txt and OpenGraph.
#
# PHASE 8: REQUIRED IN PRODUCTION, and must be https on a non-loopback host.
# lib/site-url.ts refuses to resolve otherwise and the app will not boot. Before
# Phase 8 an unset value silently fell back to the line below, which published a
# sitemap and a set of canonical tags full of localhost URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Media storage. "local" writes to ./public/media (development only).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2).
MEDIA_DRIVER="local"
# MEDIA_S3_BUCKET=""
# MEDIA_S3_REGION=""
# MEDIA_S3_ENDPOINT=""
# MEDIA_S3_ACCESS_KEY_ID=""
# MEDIA_S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket (CDN domain preferred).
# MEDIA_S3_PUBLIC_URL=""

# Seed owner account. Used ONLY by `npm run db:seed` to create the first admin.
# Change the password immediately after first login.
SEED_OWNER_EMAIL="owner@nninoceramics.co.zw"
SEED_OWNER_NAME="Nnino Owner"
SEED_OWNER_PASSWORD=""

# ---------------------------------------------------------------------------
# Phase 3 — commerce
# ---------------------------------------------------------------------------

# Which environment this deployment IS. State it explicitly: `next build` sets
# NODE_ENV=production for staging and preview deployments too, so NODE_ENV alone
# cannot tell the real shop apart from a staging copy — and that is what decides
# whether test payments are permitted. Unset means: development builds are
# development, and any production build is the real shop (the safe assumption).
# DEPLOYMENT_ENV="production"

# Which payment provider checkout uses.
#
#   manual   — REQUIRED FOR PRODUCTION until Paynow credentials exist. Checkout,
#              cart and order creation all stay open; orders are created UNPAID
#              and the studio records payment in the admin once money arrives.
#              Nothing can be marked paid without an operator.
#   sandbox  — the built-in TEST provider. The caller chooses whether the payment
#              "succeeded", so it is for development and staging only. Selecting
#              it on a production deployment resolves to "manual" and logs an
#              error rather than settling anything.
#   paynow   — not yet implemented. isConfigured() returns false until the
#              adapter is written against real credentials.
PAYMENT_PROVIDER="sandbox"

# Paynow (Webdev). NOT YET SUPPLIED — leave blank.
# Paynow issues a separate Integration ID/Key per currency, so a ZWG rollout
# later needs its own pair rather than reusing these.
# PAYNOW_INTEGRATION_ID=""
# PAYNOW_INTEGRATION_KEY=""
# Absolute URLs Paynow redirects/calls back to. Must be https in production.
# PAYNOW_RETURN_URL="https://example.com/orders"
# PAYNOW_RESULT_URL="https://example.com/api/payments/paynow/callback"

# Transactional email. "dev" writes messages to the server log instead of
# sending, so the whole order flow can be exercised with no provider account.
# A real transport also needs a domain with SPF/DKIM — Nnino currently uses
# Gmail addresses, so mail sent "from" those will be spam-filtered.
EMAIL_TRANSPORT="dev"
EMAIL_FROM="Nnino Ceramics <orders@example.com>"

# ---------------------------------------------------------------------------
# Phase 5 — production hardening
# ---------------------------------------------------------------------------

# Distributed rate limiting. Without these the limiter falls back to a
# per-instance in-memory counter, which does NOT hold across Vercel instances.
# The app still boots and logs a warning rather than refusing to serve.
# Upstash Redis REST, or anything speaking the same shape. Set both or neither.
# RATE_LIMIT_REDIS_URL=""
# RATE_LIMIT_REDIS_TOKEN=""

# Only when NOT deploying behind Vercel. Names the header carrying the true
# client IP; otherwise the leftmost x-forwarded-for entry is used.
# TRUSTED_PROXY_HEADER=""

# Origin the active payment provider redirects to. Added to the CSP form-action
# so a hosted-redirect checkout can post back.
# PAYMENT_REDIRECT_ORIGIN="https://www.paynow.co.zw"

# Ship the Content-Security-Policy in report-only mode for one deploy while
# tightening it. Violations appear in the browser console instead of blocking.
# CSP_REPORT_ONLY="false"

# debug | info | warn | error. Defaults to info in production, debug otherwise.
# LOG_LEVEL="info"

# DEPRECATED — use DEPLOYMENT_ENV="staging" instead.
# Still honoured, so existing staging deployments keep working, but the framing
# is wrong: it reads as permission to loosen production rather than as a
# statement about which environment this is. Setting it on the real shop allows
# a payment nobody made to be recorded as received.
# PAYMENTS_ALLOW_SANDBOX_IN_PRODUCTION="false"

# Production transactional email. Requires a sending domain with SPF/DKIM/DMARC
# — see docs/operations.md. Leave EMAIL_TRANSPORT="dev" until that exists;
# mail "from" a gmail.com address through a third-party provider fails DMARC
# and is quarantined or rejected.
# EMAIL_API_KEY=""
